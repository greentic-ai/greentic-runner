{
  "version": 1,
  "global": {
    "line_coverage_min": 60.0
  },
  "defaults": {
    "per_file_line_coverage_min": 60.0
  },
  "exclusions": {
    "files": [
      "crates/greentic-runner/src/main.rs",
      "crates/greentic-runner/src/bin/gen_bindings.rs",
      "crates/greentic-runner/src/bin/greentic-runner-cli.rs",
